#!/bin/bash

# MillenniumDB Unit Test Runner
# Dynamically runs all unit tests in the build/{Debug|Release}/tests/ directory
# Usage: ./scripts/run-unit-tests [Debug|Release] [--verbose] [--stop-on-fail] [test-pattern]

set -e

# Default values
BUILD_TYPE="Debug"
VERBOSE=false
STOP_ON_FAIL=false
TEST_PATTERN=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print usage
print_usage() {
    echo "Usage: $0 [BUILD_TYPE] [OPTIONS] [TEST_PATTERN]"
    echo ""
    echo "Arguments:"
    echo "  BUILD_TYPE      Build type: Debug (default) or Release"
    echo ""
    echo "Options:"
    echo "  --verbose, -v   Show detailed output from each test"
    echo "  --stop-on-fail  Stop execution on first test failure"
    echo "  --help, -h      Show this help message"
    echo ""
    echo "  TEST_PATTERN    Optional pattern to filter tests (e.g., 'operator' runs *operator* tests)"
    echo ""
    echo "Examples:"
    echo "  $0                    # Run all Debug tests"
    echo "  $0 Release            # Run all Release tests"
    echo "  $0 Debug --verbose    # Run Debug tests with verbose output"
    echo "  $0 operator           # Run tests matching 'operator' pattern"
    echo "  $0 Release operator --stop-on-fail  # Run Release operator tests, stop on failure"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        Debug|Release)
            BUILD_TYPE="$1"
            shift
            ;;
        --verbose|-v)
            VERBOSE=true
            shift
            ;;
        --stop-on-fail)
            STOP_ON_FAIL=true
            shift
            ;;
        --help|-h)
            print_usage
            exit 0
            ;;
        *)
            if [[ -z "$TEST_PATTERN" ]]; then
                TEST_PATTERN="$1"
            else
                echo -e "${RED}Error: Unknown argument '$1'${NC}"
                print_usage
                exit 1
            fi
            shift
            ;;
    esac
done

# Set test directory
TEST_DIR="${PROJECT_ROOT}/build/${BUILD_TYPE}/tests"

echo -e "${BLUE}MillenniumDB Unit Test Runner${NC}"
echo -e "${BLUE}=============================${NC}"
echo "Build Type: ${BUILD_TYPE}"
echo "Test Directory: ${TEST_DIR}"
if [[ -n "$TEST_PATTERN" ]]; then
    echo "Test Pattern: ${TEST_PATTERN}"
fi
echo ""

# Check if test directory exists
if [[ ! -d "$TEST_DIR" ]]; then
    echo -e "${RED}Error: Test directory does not exist: ${TEST_DIR}${NC}"
    echo "Please build the project first with:"
    echo "  cmake -B build/${BUILD_TYPE} -D CMAKE_BUILD_TYPE=${BUILD_TYPE}"
    echo "  cmake --build build/${BUILD_TYPE}/"
    exit 1
fi

# Find all executable test files
if [[ -n "$TEST_PATTERN" ]]; then
    # Use pattern matching
    TEST_FILES=($(find "$TEST_DIR" -maxdepth 1 -type f -executable -name "*${TEST_PATTERN}*" | sort))
else
    # Find all executable files (excluding directories)
    TEST_FILES=($(find "$TEST_DIR" -maxdepth 1 -type f -executable | sort))
fi

# Check if any tests were found
if [[ ${#TEST_FILES[@]} -eq 0 ]]; then
    if [[ -n "$TEST_PATTERN" ]]; then
        echo -e "${YELLOW}No tests found matching pattern '${TEST_PATTERN}' in ${TEST_DIR}${NC}"
    else
        echo -e "${YELLOW}No executable test files found in ${TEST_DIR}${NC}"
    fi
    exit 1
fi

echo -e "${BLUE}Found ${#TEST_FILES[@]} test(s) to run:${NC}"
for test_file in "${TEST_FILES[@]}"; do
    echo "  $(basename "$test_file")"
done
echo ""

# Initialize counters
TOTAL_TESTS=${#TEST_FILES[@]}
PASSED_TESTS=0
FAILED_TESTS=0
FAILED_TEST_NAMES=()

# Function to run a single test
run_test() {
    local test_file="$1"
    local test_name="$(basename "$test_file")"

    echo -n "Running ${test_name}... "

    # Set up environment
    export MDB_HOME="${PROJECT_ROOT}"

    # Run the test
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "\n${BLUE}--- Output for ${test_name} ---${NC}"
        if "$test_file"; then
            echo -e "${GREEN}PASSED${NC}"
            ((PASSED_TESTS++))
        else
            echo -e "${RED}FAILED${NC}"
            ((FAILED_TESTS++))
            FAILED_TEST_NAMES+=("$test_name")
            if [[ "$STOP_ON_FAIL" == "true" ]]; then
                return 1
            fi
        fi
        echo -e "${BLUE}--- End output for ${test_name} ---${NC}\n"
    else
        # Capture output and only show on failure
        local output_file=$(mktemp)
        if "$test_file" > "$output_file" 2>&1; then
            echo -e "${GREEN}PASSED${NC}"
            ((PASSED_TESTS++))
        else
            echo -e "${RED}FAILED${NC}"
            ((FAILED_TESTS++))
            FAILED_TEST_NAMES+=("$test_name")
            echo -e "${RED}--- Error output for ${test_name} ---${NC}"
            cat "$output_file"
            echo -e "${RED}--- End error output ---${NC}"
            if [[ "$STOP_ON_FAIL" == "true" ]]; then
                rm -f "$output_file"
                return 1
            fi
        fi
        rm -f "$output_file"
    fi

    return 0
}

# Run all tests
echo -e "${BLUE}Starting test execution...${NC}"
echo ""

START_TIME=$(date +%s)

for test_file in "${TEST_FILES[@]}"; do
    if ! run_test "$test_file"; then
        if [[ "$STOP_ON_FAIL" == "true" ]]; then
            echo -e "${RED}Stopping execution due to test failure.${NC}"
            break
        fi
    fi
done

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

# Print summary
echo ""
echo -e "${BLUE}Test Summary${NC}"
echo -e "${BLUE}============${NC}"
echo "Total tests: ${TOTAL_TESTS}"
echo -e "Passed: ${GREEN}${PASSED_TESTS}${NC}"
echo -e "Failed: ${RED}${FAILED_TESTS}${NC}"
echo "Duration: ${DURATION}s"

if [[ ${FAILED_TESTS} -gt 0 ]]; then
    echo ""
    echo -e "${RED}Failed tests:${NC}"
    for failed_test in "${FAILED_TEST_NAMES[@]}"; do
        echo -e "  ${RED}✗${NC} ${failed_test}"
    done
fi

echo ""

# Exit with appropriate code
if [[ ${FAILED_TESTS} -eq 0 ]]; then
    echo -e "${GREEN}All tests passed! 🎉${NC}"
    exit 0
else
    echo -e "${RED}Some tests failed.${NC}"
    exit 1
fi