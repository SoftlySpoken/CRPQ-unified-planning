#!/bin/bash

# Simple script to run planner comparison tests
# This script is a convenient wrapper around the detailed test runner

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TEST_RUNNER="$PROJECT_ROOT/tests/sparql/test_suites/internal/planner_comparison/run_planner_comparison.py"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}MillenniumDB Planner Comparison Tests${NC}"
echo "======================================"

# Check if test data exists
if [ ! -f "$PROJECT_ROOT/tests/sparql/test_suites/internal/planner_comparison/test_data.ttl" ]; then
    echo -e "${RED}Error: Test data not found. Please ensure the planner comparison tests are properly set up.${NC}"
    exit 1
fi

# Check if binaries exist
MDB_IMPORT="$PROJECT_ROOT/build/Release/bin/mdb-import"
MDB_SERVER="$PROJECT_ROOT/build/Release/bin/mdb-server"

if [ ! -f "$MDB_IMPORT" ]; then
    echo -e "${YELLOW}Warning: Release build not found, trying Debug build...${NC}"
    MDB_IMPORT="$PROJECT_ROOT/build/Debug/bin/mdb-import"
    MDB_SERVER="$PROJECT_ROOT/build/Debug/bin/mdb-server"
fi

if [ ! -f "$MDB_IMPORT" ] || [ ! -f "$MDB_SERVER" ]; then
    echo -e "${RED}Error: MillenniumDB binaries not found. Please build the project first:${NC}"
    echo "  cmake -B build/Release -D CMAKE_BUILD_TYPE=Release && cmake --build build/Release/"
    exit 1
fi

echo "Using binaries:"
echo "  Import: $MDB_IMPORT"
echo "  Server: $MDB_SERVER"
echo ""

# Change to project root
cd "$PROJECT_ROOT"

# Run the tests
echo -e "${GREEN}Running planner comparison tests...${NC}"
python3 "$TEST_RUNNER" "$@"

echo -e "${GREEN}Done!${NC}"